# Coverage config for the whole repo. Run:
#   pytest --cov --cov-report=term-missing
#   pytest --cov --cov-report=html      # browse htmlcov/index.html
[run]
source =
    app
    analysis_core
    analysis_service
omit =
    */tests/*
    */conftest.py
    analysis_service/wsgi.py
    run.py

[report]
show_missing = true
exclude_also =
    if __name__ == .__main__.:
    raise NotImplementedError
