# Copy this file to secrets.env (same directory) and fill in real values.
# secrets.env is gitignored and is read by the kustomize secretGenerator to
# build the "app-secrets" Secret.
#
#   cd deploy/k8s/overlays/local && cp secrets.example.env secrets.env
#
# Generate strong values:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Shared HMAC secret for the core -> analysis actor token. Both services read
# this same key, so setting it once here keeps them identical by construction.
ANALYSIS_TOKEN_SECRET=replace-with-a-long-random-string

# Flask session signing key for the core app.
SECRET_KEY=replace-with-a-long-random-string

# Anthropic API key — used by the analysis service only. Leave EMPTY to run the
# stack without live analysis: the service still starts and /healthz reports
# anthropic_configured=false; /analyze returns a clean "not configured" error.
# Set a real key to enable live player analysis.
ANTHROPIC_API_KEY=

# PostgreSQL passwords. Each service's DATABASE_URL is assembled from its
# password in the Deployment. Any non-empty value works locally.
CORE_DB_PASSWORD=core-local-password
ANALYSIS_DB_PASSWORD=analysis-local-password
