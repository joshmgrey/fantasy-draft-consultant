# Copy to .env for `docker compose up`. Compose reads .env automatically.

# --- Required ---------------------------------------------------------------
# Anthropic API key (used by the analysis service only).
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret for the actor token the core app sends to the analysis service.
# MUST be identical on both. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANALYSIS_TOKEN_SECRET=

# --- Core web app ----------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string

# --- Stripe (optional locally; leave blank to skip billing flows) ---------
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
